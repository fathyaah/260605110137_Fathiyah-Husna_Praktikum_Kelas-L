public class Array {
    public static void main(String[] args) {
        int[] arr1 = {1, 2, 3, 4, 5};
        int[][] arr2 = {{6, 7}, {8, 9, 10}};

        System.out.println("Array 1:");
        System.out.println(arr1[0] + " = " + (arr1[0] % 2 == 0 ? "Genap" : "Ganjil"));
        System.out.println(arr1[1] + " = " + (arr1[1] % 2 == 0 ? "Genap" : "Ganjil"));
        System.out.println(arr1[2] + " = " + (arr1[2] % 2 == 0 ? "Genap" : "Ganjil"));
        System.out.println(arr1[3] + " = " + (arr1[3] % 2 == 0 ? "Genap" : "Ganjil"));
        System.out.println(arr1[4] + " = " + (arr1[4] % 2 == 0 ? "Genap" : "Ganjil"));

        System.out.println("Array 2:");
        System.out.println(arr2[0][0] + " = " + (arr2[0][0] % 2 == 0 ? "Genap" : "Ganjil"));
        System.out.println(arr2[0][1] + " = " + (arr2[0][1] % 2 == 0 ? "Genap" : "Ganjil"));
        System.out.println(arr2[1][0] + " = " + (arr2[1][0] % 2 == 0 ? "Genap" : "Ganjil"));
        System.out.println(arr2[1][1] + " = " + (arr2[1][1] % 2 == 0 ? "Genap" : "Ganjil"));
        System.out.println(arr2[1][2] + " = " + (arr2[1][2] % 2 == 0 ? "Genap" : "Ganjil"));
    }
}
